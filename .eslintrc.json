{
  "root": true,
  "extends": ["next/core-web-vitals", "plugin:@typescript-eslint/recommended"],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "ignorePatterns": ["node_modules/", ".next/", "public/", "docs/", "supabase/", "next-env.d.ts"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/explicit-function-return-type": [
      "error",
      {
        "allowExpressions": true,
        "allowTypedFunctionExpressions": true,
        "allowHigherOrderFunctions": true,
        "allowDirectConstAssertionInArrowFunctions": true
      }
    ],
    "@typescript-eslint/explicit-module-boundary-types": "error",
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "@typescript-eslint/consistent-type-imports": ["error", { "prefer": "type-imports", "fixStyle": "inline-type-imports" }],
    "no-console": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "react/no-danger": "error",
    "eqeqeq": ["error", "always"],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "Literal[value=/[^\\x00-\\x7F]/]",
        "message": "Only English (ASCII) text is allowed in source files."
      },
      {
        "selector": "TemplateElement[value.raw=/[^\\x00-\\x7F]/]",
        "message": "Only English (ASCII) text is allowed in source files."
      },
      {
        "selector": "JSXText[value=/[^\\x00-\\x7F]/]",
        "message": "Only English (ASCII) text is allowed in source files."
      },
      {
        "selector": "AssignmentExpression[left.property.name='innerHTML']",
        "message": "Do not assign innerHTML. Use sanitized React rendering."
      },
      {
        "selector": "AssignmentExpression[left.property.name='outerHTML']",
        "message": "Do not assign outerHTML. Use sanitized React rendering."
      }
    ]
  },
  "overrides": [
    {
      "files": ["lib/logger/sink.ts"],
      "rules": { "no-console": "off" }
    },
    {
      "files": ["components/shared/safe-html.tsx"],
      "rules": { "react/no-danger": "off" }
    }
  ]
}
