# GENERATED - do not edit. Source: config/env/sNN.env.fragment (run: npm run gen)
# Copy to .env.local for development. Never commit real values. Use different secrets in every environment.

# ===== S01 =====
# --- Application ---
APP_ENV=development
LOG_LEVEL=info
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to 1 only for CI builds and local tooling that must not read secrets.
SKIP_ENV_VALIDATION=
# Set to 1 together with APP_ENV=development to open the /dev/shell-* preview pages.
SHELL_PREVIEW=

# --- Supabase (text and accounting data always live here) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct connection string used by migration tooling.
DATABASE_URL=

# --- Secrets (generate a different value for every environment) ---
# Master encryption key, 32 random bytes in base64:  openssl rand -base64 32
ENCRYPTION_KEY=
# Token signing secret, at least 32 random bytes in base64:  openssl rand -base64 48
HMAC_TOKEN_SECRET=
# Audit log signing seed (Ed25519), 32 random bytes in base64:  openssl rand -base64 32
AUDIT_SIGNING_KEY=
# Shared secret for scheduled job entry points, at least 32 characters:  openssl rand -hex 32
CRON_SECRET=

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Platform SMTP (optional here; can also be set in the admin dashboard) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Google OAuth client (only needed so companies can link their own Google Drive) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- VPN, proxy and Tor detection data source: none, ipqualityscore or maxmind ---
NETWORK_INTEL_PROVIDER=none
NETWORK_INTEL_API_KEY=
MAXMIND_DB_PATH=

# --- Error monitoring ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ===== S03 =====
# --- STEP 03: sign-in with Google and GitHub (optional; a provider is shown only when its id and secret are set) ---
# Redirect URI to register at the provider: <NEXT_PUBLIC_APP_URL>/oauth/callback/google and /oauth/callback/github
# Google uses GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET from the STEP 01 section.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ===== S05 =====
# --- STEP 05: encryption key versions, malware scanner ---
# ENCRYPTION_KEY (STEP 01 section) is key version 1 and must never change.
# To rotate: generate a new key (openssl rand -base64 32), set it as ENCRYPTION_KEY_V2, deploy,
# set ENCRYPTION_ACTIVE_KEY_VERSION=2, run the rotation job, and keep ENCRYPTION_KEY_V2 and ENCRYPTION_KEY forever.
ENCRYPTION_KEY_V2=
ENCRYPTION_KEY_V3=
ENCRYPTION_ACTIVE_KEY_VERSION=1
# Optional HTTPS gateway in front of ClamAV. Leave empty to skip the scanner hook.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=

# ===== S06 =====
# --- STEP 06: public site ---
# Address that receives messages from the public contact form (falls back to the SMTP_FROM address).
CONTACT_INBOX=
# Access token of the Meta conversions API (server-side events, sent only with marketing consent). Optional.
META_CAPI_ACCESS_TOKEN=
