{
  "meta": {
    "name": "KD SOLUTION IT design tokens",
    "version": 1,
    "note": "Single source of truth. Run npm run gen to produce styles/tokens.generated.css and public/design-tokens.json."
  },
  "spacing": {
    "4": "4px",
    "8": "8px",
    "12": "12px",
